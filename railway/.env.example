# App Web CX · configuración de ejemplo para hosting independiente.
# No guarde valores reales en Git.

PORT=3000
NODE_ENV=production
DATA_MODE=PRODUCTION

# PostgreSQL
DATABASE_URL=postgresql://cx_user:CAMBIAR_PASSWORD@db:5432/cx_db
DATABASE_SSL=disable
DB_SCHEMA=qx_app

# Seguridad. Use valores aleatorios de 32+ caracteres.
SESSION_SECRET=REEMPLAZAR_POR_SECRETO_LARGO
AUTH_PEPPER=REEMPLAZAR_POR_SECRETO_LARGO_DISTINTO

# Se usan únicamente si qx_users está vacío.
BOOTSTRAP_ADMIN_USER=superadmin
BOOTSTRAP_ADMIN_NAME=Superadministrador
BOOTSTRAP_ADMIN_PIN=CAMBIAR_PIN_VALIDO

# URL pública del sitio cuando se conozca.
APP_PUBLIC_URL=https://cirugia.ejemplo.com

# Opcionales. Push permanece deshabilitado por defecto.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
