# Copie este archivo como .env y reemplace todos los valores sensibles.

APP_PORT=3000

POSTGRES_DB=cx_db
POSTGRES_USER=cx_user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_BD
DB_SCHEMA=qx_app

# Mínimo 32 caracteres. Deben ser distintos entre sí.
SESSION_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_LARGO
AUTH_PEPPER=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_LARGO

# Solo se utiliza cuando la base no contiene usuarios.
BOOTSTRAP_ADMIN_USER=superadmin
BOOTSTRAP_ADMIN_NAME=Superadministrador
BOOTSTRAP_ADMIN_PIN=CAMBIAR_PIN_VALIDO

APP_PUBLIC_URL=https://cirugia.ejemplo.com
